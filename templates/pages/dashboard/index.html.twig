{% extends 'layouts/app.html.twig' %}

{% block title %}User Management - Dashboard{% endblock %}

{% block stylesheets %}
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="https://gyrocode.github.io/jquery-datatables-checkboxes/1.2.12/css/dataTables.checkboxes.css" rel="stylesheet">
    <!-- Toastr CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet">
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        .toolbar { margin-bottom: 15px; }
        .row-checkbox { cursor: pointer; }
        div.dataTables_wrapper div.dataTables_length select {
            width: auto !important;
            display: inline-block !important;
            padding-right: 1.8rem !important;
            padding-left: 0.8rem !important;
            min-width: 70px;
        }
    </style>
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-dark">User Management</h5>
                
                <!-- Toolbar over the table with actions -->
                <div class="toolbar btn-group mb-0" role="group" aria-label="Toolbar">
                    <button type="button" class="btn btn-warning text-white" id="btn-block" disabled data-bs-toggle="tooltip" title="Block selected users">
                        Block
                    </button>
                    <button type="button" class="btn btn-success" id="btn-unblock" disabled data-bs-toggle="tooltip" title="Unblock selected users">
                        <i class="fa-solid fa-unlock"></i>
                    </button>
                    <button type="button" class="btn btn-danger" id="btn-delete" disabled data-bs-toggle="tooltip" title="Delete selected users">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                    <button type="button" class="btn btn-secondary" id="btn-delete-unverified" disabled data-bs-toggle="tooltip" title="Delete selected unverified users">
                        <i class="fa-solid fa-user-xmark"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive rounded-bottom p-3" >
                    <table class="table  mb-0 align-middle text-wrap table-hover w-100" id="userTable">
                        <thead class="text-dark fs-4">
                            <tr>
                                <th style="width: 40px;" class="text-center not-exported">
                                    <input type="checkbox" class="form-check-input" id="select-all" aria-label="Select all rows">
                                </th>
                                <th>Name</th>
                                <th>E-Mail</th>
                                <th>Status</th>
                                <th>Last Seen</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://gyrocode.github.io/jquery-datatables-checkboxes/1.2.12/js/dataTables.checkboxes.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        $(document).ready(function () {
            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-right",
            };



            // Initialize DataTable (Server-side)
            var table = $('#userTable').DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                order: [[4, 'desc']],
                lengthMenu: [[5, 10, 50, 100], [5, 10, 50, 100]],
                ajax: "{{ path('app_dashboard_user_data') }}",
                createdRow: function (row, data, dataIndex) {
                    $(row).attr('data-id', data.id);
                },
                columnDefs: [
                    {
                        orderable: false,
                        searchable: false,
                        className: 'text-center',
                        targets: [0],
                        render: function (data, type, row, meta) {
                            if (type === 'display') {
                                data = '<input type="checkbox" class="dt-checkboxes form-check-input" value="' + data + '">';
                            }
                            return data;
                        },
                        checkboxes: {
                            selectRow: true,
                            selectAllRender: '<input type="checkbox" class="dt-checkboxes form-check-input" id="select-all">'
                        }
                    }
                ],
                columns: [
                    { data: 'id' },
                    { data: 'fullname' },
                    { data: 'email' },
                    { data: 'status' },
                    { 
                        data: 'last_seen',
                        render: function (data, type, row) {
                            if (!data) return '<span class="text-muted">Never</span>';
                            
                            if (type === 'display') {
                                let bars = '';
                                if (data.history && data.history.length > 0) {
                                    data.history.forEach(ts => {
                                        let date = new Date(ts * 1000);
                                        let hour = date.getHours(); 
                                        let height = Math.floor((hour / 23) * 70) + 30;
                                        bars += '<div title="' + date.toLocaleString() + '" data-bs-toggle="tooltip" style="width: 6px; height: ' + height + '%; background-color: #9daafe; margin-right: 3px; display: inline-block; border-radius: 1px;"></div>';
                                    });
                                } else {
                                    for(let i=0; i<8; i++) {
                                        bars += '<div style="width: 6px; height: 10%; background-color: #e2e8f0; margin-right: 3px; display: inline-block; border-radius: 1px;"></div>';
                                    }
                                }
                                
                                return `
                                    <div class="d-flex flex-column align-items-start" style="width: fit-content;">
                                        <span class="mb-1 text-dark" title="${data.absolute}" data-bs-toggle="tooltip" data-bs-placement="top" style="cursor: pointer;">${data.relative}</span>
                                        <div style="height: 16px; display: flex; align-items: flex-end; opacity: 0.8;">
                                            ${bars}
                                        </div>
                                    </div>
                                `;
                            }
                            return data.timestamp;
                        }
                    }
                ],
                order: [],
                language: {
                    search: "Search:",
                    searchPlaceholder: "Name, email...",
                    lengthMenu: "Show _MENU_ users",
                }
            });

            function toggleToolbar() {
                var selectedCount = table.column(0).checkboxes.selected().length;
                $('.toolbar .btn').prop('disabled', selectedCount === 0);
            }

            $('#userTable').on('change', 'input[type="checkbox"]', function () {
                setTimeout(function() {
                    toggleToolbar();
                }, 50);
            });
            table.on('draw', function() {
                setTimeout(function() {
                    toggleToolbar();
                }, 50);
                
                // Initialize tooltips for the new elements
                if (typeof bootstrap !== 'undefined') {
                    var tooltipTriggerList = [].slice.call(document.querySelectorAll('#userTable [data-bs-toggle="tooltip"]'))
                    tooltipTriggerList.map(function (tooltipTriggerEl) {
                        return new bootstrap.Tooltip(tooltipTriggerEl)
                    });
                }
            });

            $('.toolbar .btn').on('click', function () {
                var actionId = $(this).attr('id');
                var actionMap = {
                    'btn-block': 'block',
                    'btn-unblock': 'unblock',
                    'btn-delete': 'delete',
                    'btn-delete-unverified': 'delete_unverified'
                };
                
                var action = actionMap[actionId];
                if (!action) return;

                var ids = [];
                $.each(table.column(0).checkboxes.selected(), function(index, rowId){
                    ids.push(rowId);
                });

                if (ids.length === 0) {
                    toastr.warning('Please select at least one record!', 'Oops!');
                    return;
                }

                var actionText = action.replace('_', ' ');
                
                Swal.fire({
                    title: 'Are you sure?',
                    text: 'You are about to ' + actionText + ' ' + ids.length + ' user(s).',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, ' + actionText + '!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "{{ path('app_dashboard_user_action') }}",
                            type: 'POST',
                            data: {
                                action: action,
                                ids: ids
                            },
                            success: function (response) {
                                if (response.status === 200) {
                                    toastr.success(response.message, response.title);
                                    table.ajax.reload(null, false);
                                    table.column(0).checkboxes.deselectAll();
                                    toggleToolbar();
                                    
                                    if (response.self_affected) {
                                        setTimeout(function() {
                                            window.location.reload();
                                        }, 1500);
                                    }
                                } else {
                                    toastr.error(response.message, response.title);
                                }
                            },
                            error: function () {
                                toastr.error('An error occurred while processing your request.', 'Error');
                            }
                        });
                    }
                });
            });
        });
    </script>
{% endblock %}
